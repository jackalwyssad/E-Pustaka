<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogReviewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tulis Ulasan &amp; Penilaian"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="Beri penilaian bintang dan ulasan Anda untuk buku ini:"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Rating Bar -->
    <RatingBar
        android:id="@+id/rbReviewRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:numStars="5"
        android:progressTint="@color/gold_star"
        android:rating="5"
        android:secondaryProgressTint="@color/gold_star"
        android:stepSize="1" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Epustaka.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Tulis Pendapat / Ulasan Anda">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:lines="4"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
